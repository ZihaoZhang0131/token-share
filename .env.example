# Copy to .env, replace every CHANGE_ME value, then keep the file only on the server.
DOMAIN=token.example.com
LETSENCRYPT_EMAIL=admin@example.com
TLS_ENABLED=false

POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD
SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Generate with: python -m app.cli generate-encryption-key
TOKEN_ENCRYPTION_KEY=CHANGE_ME_URLSAFE_BASE64_32_BYTES
TOKEN_ENCRYPTION_KEY_VERSION=1

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_INITIAL_PASSWORD
