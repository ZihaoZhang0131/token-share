server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /health/live {
        proxy_pass http://api:8000/health/live;
    }

    location / {
        default_type text/plain;
        return 503 "HTTPS certificate setup is pending.\n";
    }
}
